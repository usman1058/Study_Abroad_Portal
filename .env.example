# Auth.js (NextAuth v5)
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# PostgreSQL (used by both the runtime driver adapter and the Prisma CLI)
DATABASE_URL="---------------------"

# Vercel Cron secret — must match the header Vercel sends to /api/cron/*
CRON_SECRET="replace-with-another-long-random-string"

# Public base URL used for WhatsApp share links (no trailing slash)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible). Create a scoped R2 API token with Object Read &
# Write for the selected bucket, then use its S3 Access Key ID and Secret here.
# Endpoint: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# Use separate bucket credentials for production and preview in Vercel.
# Optional locally: without these values uploads fall back to StoredFile in Postgres.
AWS_ENDPOINT_URL_S3="https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID="replace-with-r2-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
AWS_REGION="auto"
S3_BUCKET="study-abroad-portal-prod"

# Transactional email (CheckMyUni mailbox over authenticated SSL/TLS SMTP).
# Keep SMTP_PASSWORD only in an ignored local env file or Vercel Secret.
SMTP_HOST="mail.checkmyuni.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@checkmyuni.com"
SMTP_PASSWORD=""
MAIL_FROM="CheckMyUni <info@checkmyuni.com>"
MAIL_REPLY_TO="info@checkmyuni.com"
# Optional HTTPS fallback if SMTP is unavailable.
RESEND_API_KEY=""
