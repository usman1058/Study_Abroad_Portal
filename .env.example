# Auth.js (NextAuth v5)
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# PostgreSQL (used by both the runtime driver adapter and the Prisma CLI)
DATABASE_URL="---------------------"

# Vercel Cron secret — must match the header Vercel sends to /api/cron/*
CRON_SECRET="replace-with-another-long-random-string"

# Optional defaults used by the app
NEXT_PUBLIC_APP_NAME="StudyAbroad Portal"

# Public base URL used for WhatsApp share links (no trailing slash)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# S3-compatible object storage (Neon). Student documents and course receipts are
# stored here; Postgres only keeps the object key (`s3:<key>`). Generate a key in
# the Neon console: Storage -> Credentials.
AWS_ENDPOINT_URL_S3="https://<region>.storage.<provider>.neon.tech"
AWS_ACCESS_KEY_ID="replace-with-the-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-the-secret-access-key"
AWS_REGION="ap-southeast-1"
S3_BUCKET="assets"
